{
  "name": "typeforge-cli",
  "version": "0.1.0",
  "description": "TypeForge — TypeScript project scaffolding CLI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "typeforge": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": ["typescript", "scaffold", "cli", "generator"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
