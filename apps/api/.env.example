# connection_limit controls Prisma's built-in pool size (default 5 per instance)
DATABASE_URL="postgresql://postgres:password@localhost:5432/typeforge?connection_limit=10&connect_timeout=10"
REDIS_URL="redis://localhost:6379"

# JWT — generate with: openssl rand -base64 64
JWT_SECRET="change-me-to-a-strong-random-secret"
JWT_REFRESH_SECRET="change-me-to-a-strong-random-refresh-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3000
NODE_ENV=development

# Must be set in production — startup will fail if missing
FRONTEND_URL="http://localhost:4200"

# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Google Gemini — direct API (free tier at https://aistudio.google.com/apikey)
# AI_MENTOR_PROVIDER=gemini
# GEMINI_API_KEY=""
# GEMINI_MODEL=gemini-2.0-flash

# OpenRouter — route AI Mentor through OpenRouter (supports Gemini, GPT-4o, etc.)
# Set AI_MENTOR_PROVIDER=openrouter and provide your key from https://openrouter.ai/keys
# AI_MENTOR_PROVIDER=openrouter
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Local dev only — route AI Mentor through Claude CLI (uses `claude auth login`).
# Ignored when NODE_ENV=production. Unset ANTHROPIC_API_KEY to use subscription billing.
# AI_MENTOR_PROVIDER=cli
# CLAUDE_CLI_PATH=claude
# CLAUDE_CLI_MODEL=

# Optional: report errors to Sentry (omit to disable)
SENTRY_DSN=""

# SMTP for password reset emails (omit to use Ethereal test account in dev)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@typeforge.dev"

# Admin user created on first seed (change before production)
ADMIN_EMAIL="admin@typeforge.dev"
ADMIN_PASSWORD="Admin1234!"
